{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Window Manager Tauri",
  "identifier": "dev.projectwm.twm-tauri",
  "build": {
    "beforeDevCommand": "bun run hmr",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:view",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Terminal Window Manager Tauri",
        "width": 1480,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "backgroundColor": "#0E0E0E",
        "decorations": false,
        "center": true,
        "create": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Project-based terminal manager",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico", "icons/app-icon.svg"],
    "resources": ["resources/"]
  }
}
